#
# Khronos31 | .commonrc
#
# bash/zsh 共通の「対話シェル用」設定。.bashrc / .zshrc から読まれる。
#
# PATH と LANG はここではなく .common_env に置く。このファイルは対話
# ガードの内側でしか走らないため、ここに環境変数を書くと `ssh host
# 'コマンド'` のような非対話シェルに届かない。

[ -f ~/.common_aliases ] && . ~/.common_aliases

if ! command -v which >/dev/null 2>&1; then
  # Termux/HAOS(Debian minimal)等、whichコマンド自体が入っていない環境向けのポータブル代替。
  # command -v だけで完結するのでPOSIX準拠。
  #
  # eval で包むのは、Fedora/RHEL 系が /etc/profile.d/which2.sh で which をエイリアス
  # 定義しているため。エイリアス展開はパース時に起きるので、素で which() と書くと
  # この if が実行されない環境でも構文エラーになる。eval なら、この分岐に入る環境
  # （= which が存在しない = エイリアスも無い）でしか解析されない。
  # 関数名を \which とクォートする方法は使えない。bash が「not a valid identifier」
  # として実行時に弾き、関数が定義されないため。
  eval 'which() {
    local cmd found=1
    for cmd in "$@"; do
      if command -v "$cmd" >/dev/null 2>&1; then
        command -v "$cmd"
        found=0
      else
        printf "%s not found\n" "$cmd" >&2
      fi
    done
    return $found
  }'
fi

if command -v luarocks >/dev/null; then
  eval "$(luarocks path)"
fi

if command -v opam >/dev/null; then
  eval "$(opam env)"
fi

[ -d "/Applications/Filza.app" ] &&
filza() {
  local suffix=""
  local filepath="."
  if [ $# -ge 1 ]; then
    filepath="$1"
  fi
  if ! [ -e "$filepath" ]; then
    printf 'filza: no such file or directory: %s\n' "$filepath" >&2
    return 1
  elif [ -d "$filepath" ]; then
    suffix="/."
  fi
  uiopen filza://view/"$(realpath -z "$filepath"|tr -d '\0'|od -tx1 -v -An|tr ' ' '%'|tr -d '\n')""$suffix"
}

# クリップボード。
#
# 既定は端末のOSC 52シーケンスで「手元の」クリップボードへ送る。
# ローカルのクリップボード実体(xclip / pbcopy / termux-clipboard-set 等)を
# 使いたいときだけ --native を付ける。
#
# 2026-09-09に既定を反転した。以前はネイティブが既定で --osc52 で切り替える形
# だったが、SSH越しに使う場面が圧倒的に多く、既定が「繋いだ先のクリップボード」
# を指しているのは実態と噛み合わなかった。
# OSC 52は端末側の対応が要る（未対応の端末では黙って何も起きない）。
#
# GNUの -w0 はBSD/macOSに無い場合があるため tr で改行を落とす。
_clip_osc52() {
  printf '\033]52;c;%s\a' "$(base64 | tr -d '\n')"
}

if command -v xclip >/dev/null; then
  _clip_native() { xclip -selection c; }
  alias pbpaste='xclip -selection c -o'
elif command -v termux-clipboard-set >/dev/null; then
  _clip_native() { termux-clipboard-set; }
  alias pbpaste='termux-clipboard-get'
elif [ -r /dev/clipboard ]; then
  _clip_native() { cat >/dev/clipboard; }
  pbpaste() {
    cat /dev/clipboard
  }
elif command -v pbcopy >/dev/null; then
  # macOS。関数名が実体と同じなので、command を挟まないと自分を呼んで無限再帰する。
  _clip_native() { command pbcopy; }
fi

pbcopy() {
  case "${1:-}" in
    --native)
      if command -v _clip_native >/dev/null; then
        _clip_native
      else
        # 明示的に --native を求められたが実体が無い。ここで黙って捨てると
        # パイプで渡された内容が消えるので、断ってからOSC 52へ回す。
        echo 'pbcopy: ネイティブのクリップボードが無いため OSC 52 で送る' >&2
        _clip_osc52
      fi
      ;;
    ''|--osc52)
      # 引数なしが既定。--osc52 は旧来の綴りで、意味は既定と同じ
      _clip_osc52
      ;;
    *)
      echo "pbcopy: 不明なオプション: $1 (使えるのは --native / --osc52)" >&2
      return 2
      ;;
  esac
}

# aliases and environment variables for textimg
export RUNEWIDTH_EASTASIAN=1
#export TEXTIMG_FONT_FILE="$HOME/Library/Fonts/PlemolJP-Text.ttf"
#export TEXTIMG_EMOJI_DIR="$HOME/Library/Fonts/emoji/noto-emoji/png/128"
alias textimg='TEXTIMG_OUTPUT_DIR="$(pwd)" textimg'

if command -v ldid >/dev/null; then
  if [ -f /usr/share/entitlements/general.xml ]; then
    export ENTFILE="/usr/share/entitlements/general.xml"
  fi
  resign() {
    local file
    for file in "$@"; do
      ldid -S"$ENTFILE" -M "$file"
    done
  }
fi

hostname_color="$(
  [ -f /etc/os-release ] && . /etc/os-release
  echo "$((0x$(echo -n "$(uname -n)$NAME"|md5sum|head -c8) % 214 + 17))"
)"

# その機械にしか無い対話用の設定はここへ。git では追跡しない。
# 環境変数(PATH等)は .common_env.local の担当。こちらは bash/zsh の構文が
# 使えるので、補完の読み込みなど POSIX sh で書けないものを置く。
[ -f ~/.commonrc.local ] && . ~/.commonrc.local
